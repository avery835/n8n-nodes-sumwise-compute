      "type": "n8n-nodes-sumwise-compute.sumWiseCompute",
      "typeVersion": 1,
      "parameters": {
        "operation": "evaluate",
        "expression": "={{ \"(\" + $json.sourceTotalA + \") - (\" + $json.sourceTotalB + \")\" }}"
