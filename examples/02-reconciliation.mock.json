        1220,
        420
      ]
    },
    {
      "id": "note",
      "name": "MOCK / SYNTHETIC ONLY",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "parameters": {
        "content": "## Two synthetic totals, no customer data\nSource A = \"10501\"; source B = \"10500\". Values stay strings. SumWise computes the difference, and the standard If node checks exactness and zero text. No email, CRM, or finance system is connected.\n\nSelect a local MOCK credential. The fixture returns exact \"1\", taking the exception branch. Set A to \"10500\" for the fixed exact-zero fixture. Real-service use is unexecuted and needs separate authorization.",
        "height": 200,
        "width": 580
      },
      "position": [
        180,
        0
      ]
    }
  ],
